S.statusLabel = statusLabel

local function startFarm()
    if S.unloaded then return end
    S.running = true
    S.runningSince = 0
    S.runs = 0
    S.runTimes = {}
    S.lastGoAt = 0
    -- both modes need AutoDrive active
    installDrivePatch()
    if S.mode == "Drive" then
        applyMaxSpeed()
    else
        restoreMaxSpeed()
    end
    placeMarker()
    setStatus("Starting farm")
    WindUI:Notify({ Title = "Auto Farm", Content = "Started (" .. S.mode .. ")", Duration = 3 })
end

local function stopFarm()
    S.running = false
    S.runningSince = 0
    restoreDrivePatch()
    restoreMaxSpeed()
    setStatus("Stopped")
    WindUI:Notify({ Title = "Auto Farm", Content = "Stopped", Duration = 3 })
end

local function unloadAll()
    if S.unloaded then return end
    S.unloaded = true
    S.running = false
    restoreDrivePatch()
    restoreMaxSpeed()
    removeMarker()
    for _, conn in ipairs(S.connections) do
        pcall(function() conn:Disconnect() end)
    end
    S.connections = {}
    if S.keybindConn then pcall(function() S.keybindConn:Disconnect() end) S.keybindConn = nil end
    if S.sideButton then
        pcall(function() S.sideButton:Destroy() end)
        S.sideButton = nil
    end
    task.delay(0.5, function()
        pcall(function() Window:Destroy() end)
    end)
end

