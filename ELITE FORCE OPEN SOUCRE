local loader = loadstring(MAIN)
if not loader then
	warn("[SWAT Farm] failed to compile")
	return
end

local ok, err = pcall(function()
	local fn = loader()
	if type(fn) ~= "function" then
		error("script chunk did not return a function")
	end
	return fn(MAIN)
end)

if not ok then
	warn("[SWAT Farm] runtime error: " .. tostring(err))
end
