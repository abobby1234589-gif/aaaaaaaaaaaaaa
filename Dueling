local function onImpact(impactId, payload)
    if State.unloaded or not State.autoParry then
        return
    end
    if type(impactId) ~= "number" and type(impactId) ~= "string" then
        return
    end
    if type(payload) == "table" and payload.sourceModule == nil then
        return
    end

    if math.random() * 100 > State.parryChance then
        State.missed = State.missed + 1
        return
    end

    State.parried = State.parried + 1
    if holdImpactFlag("IsParrying", impactId, function()
        State.parryHeld = false
    end) then
        State.parryHeld = true
    end

    if State.parryNotify then
        notify("Parried impact #" .. tostring(impactId), 1)
    end
end

local function onDodgeImpact(impactId)
    if State.unloaded or not State.godMode then
        return
    end
    if type(impactId) ~= "number" and type(impactId) ~= "string" then
        return
    end

    State.dodged = State.dodged + 1
    holdImpactFlag("IsDodging", impactId)
end

local function connectImpactEvents()
    if State.remotesReady or not RegisterImpact then
        return
    end
    local ok = pcall(function()
        track(RegisterImpact.OnClientEvent:Connect(onImpact))
        track(RegisterImpact.OnClientEvent:Connect(onDodgeImpact))
    end)
    if ok then
        State.remotesReady = true
    end
end

task.spawn(function()
    local attempts = 0
    while not State.unloaded do
        if not RegisterImpact then
            RegisterImpact = findChild(ReplicatedStorage, "Remotes", "PlayerCharacter", "Update", "RegisterImpact")
        end
        if not RequestSetCurrentWeapon then
            RequestSetCurrentWeapon = findChild(ReplicatedStorage, "Remotes", "WeaponInventory", "Request_SetCurrentWeapon")
        end

        connectImpactEvents()

        if State.remotesReady and RequestSetCurrentWeapon then
            break
        end

        attempts += 1
        if attempts >= 15 then
            if not State.remotesReady then
                report("could not find RegisterImpact, auto parry and god mode stay unavailable")
                notify("Game remotes not found - auto parry and god mode are unavailable.", 5)
            end
            break
        end
        task.wait(1)
    end
end)

track(RunService.Heartbeat:Connect(function()
    if State.unloaded or not State.applySkin then
        return
    end

    local handler = getCharacterHandler()
    if not handler then
        return
    end

    local weaponType = handler.EquippedWeapon
    local skin = SelectedSkin[weaponType]
    if not skin then
        return
    end

    local weaponHandler = getWeaponHandler(handler)
    if not weaponHandler then
        return
    end

    if weaponHandler.CurrentCosmetic ~= cosmeticId(skin, weaponType) then
        pcall(applySkinNow)
    end
end))

