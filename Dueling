local Connections = {}

local function track(connection)
    Connections[#Connections + 1] = connection
    return connection
end

local function report(message)
    local text = "[Dueling Grounds] " .. tostring(message)
    if type(warn) == "function" then
        warn(text)
    else
        print(text)
    end
end

local function notify(content, duration)
    if not WindUI then
        report(content)
        return
    end
    pcall(function()
        WindUI:Notify({
            Title = "Dueling Grounds",
            Content = content,
            Duration = duration or 2.5,
        })
    end)
end

local function findChild(parent, ...)
    local names = { ... }
    local current = parent
    for i = 1, #names do
        if not current then
            return nil
        end
        local ok, child = pcall(function()
            return current:FindFirstChild(names[i])
        end)
        if not ok or not child then
            return nil
        end
        current = child
    end
    return current
end

