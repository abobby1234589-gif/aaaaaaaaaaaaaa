local CharacterController = nil

local function getCharacterController()
    if CharacterController then
        return CharacterController
    end
    local ok, controller = pcall(function()
        return require(ReplicatedStorage.Controllers.CharacterController)
    end)
    if ok and type(controller) == "table" then
        CharacterController = controller
        return CharacterController
    end
    return nil
end

local function getCharacterHandler()
    local controller = getCharacterController()
    if not controller then
        return nil
    end
    local ok, handler = pcall(controller.GetLocalCharacterHandler, controller)
    if ok and type(handler) == "table" and handler.ActionManager then
        return handler
    end
    return nil
end

local function getWeaponHandler(handler)
    if not handler then
        return nil
    end
    local ok, weaponHandler = pcall(function()
        return handler:GetEquippedWeaponHandler()
    end)
    if ok and type(weaponHandler) == "table" then
        return weaponHandler
    end
    local fallbackOk, fallback = pcall(function()
        return handler.EquippedWeaponHandler or handler.WeaponHandler
    end)
    if fallbackOk and type(fallback) == "table" then
        return fallback
    end
    return nil
end

local function holdImpactFlag(field, impactId, onDone)
    local handler = getCharacterHandler()
    if not handler then
        return false
    end
    if handler[field] == true then
        return false
    end

    local actionManager = handler.ActionManager
    local previous = handler[field]

    local setOk = pcall(function()
        handler[field] = true
    end)
    if not setOk then
        return false
    end

    task.spawn(function()
        local deadline = os.clock() + 0.6

        while true do
            RunService.Heartbeat:Wait()
            local pending = actionManager and actionManager.UnresolvedImpacts and actionManager.UnresolvedImpacts[impactId] ~= nil
            if not pending or os.clock() > deadline then
                break
            end
        end

        local current = getCharacterHandler()
        if current == handler and current[field] == true then
            pcall(function()
                current[field] = previous
            end)
        end
        if onDone then
            onDone()
        end
    end)

    return true
end

