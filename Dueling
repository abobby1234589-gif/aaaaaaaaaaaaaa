local WeaponTypes = {}
local SelectedSkin = {}

for weaponType, skins in pairs(SKINS) do
    table.sort(skins)
    WeaponTypes[#WeaponTypes + 1] = weaponType
end
table.sort(WeaponTypes)

for _, weaponType in ipairs(WeaponTypes) do
    local fallback = SKINS[weaponType][1]
    for _, skin in ipairs(SKINS[weaponType]) do
        if skin:sub(1, 7) == "Default" then
            fallback = skin
            break
        end
    end
    SelectedSkin[weaponType] = fallback
end

local AppliedCosmetics = setmetatable({}, { __mode = "k" })

local function cosmeticId(skin, weaponType)
    return (skin:gsub(weaponType, ""))
end

local function applyCosmetic(weaponHandler, cosmetic, alternativeName)
    local cosmetics = weaponHandler.WeaponInfo and weaponHandler.WeaponInfo.Cosmetics
    if not cosmetics then
        return false
    end

    local target = cosmetics[cosmetic] or (alternativeName and cosmetics[alternativeName])
    if not target then
        return false
    end

    local ok, module = pcall(require, target)
    if not ok or type(module) ~= "table" or not module.WeaponModel then
        return false
    end

    local clonedOk, clone = pcall(function()
        return module.WeaponModel:Clone()
    end)
    if not clonedOk or not clone then
        return false
    end

    for _, descendant in ipairs(clone:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant.CanCollide = false
            descendant.CanQuery = false
            descendant.CanTouch = false
            descendant.Massless = true
        end
    end

    local parent = weaponHandler.WeaponModel and weaponHandler.WeaponModel.Parent or weaponHandler.WeaponInstance

    if weaponHandler.WeaponModel then
        pcall(function()
            weaponHandler.WeaponModel:Destroy()
        end)
    end

    local blade = clone:FindFirstChild("Blade")
    local trail = blade and blade:FindFirstChild("Trail") or nil
    local ultimateTrail = blade and blade:FindFirstChild("UltimateTrail") or nil

    if trail then
        pcall(function()
            trail:SetAttribute("WidthScale", trail.WidthScale)
            trail:SetAttribute("MaxLength", trail.MaxLength)
            trail.Enabled = false
        end)
    end

    if ultimateTrail then
        pcall(function()
            ultimateTrail:SetAttribute("WidthScale", ultimateTrail.WidthScale)
            ultimateTrail:SetAttribute("MaxLength", ultimateTrail.MaxLength)
            ultimateTrail.Enabled = false
        end)
    end

    pcall(function()
        clone.Parent = parent
    end)

    pcall(function()
        weaponHandler.WeaponModel = clone
        weaponHandler.Blade = blade
        weaponHandler.Trail = trail
        weaponHandler.UltimateTrail = ultimateTrail
        weaponHandler.CurrentCosmetic = cosmetic
        weaponHandler.CosmeticInfo = module
    end)

    return true
end

local function applySkinNow()
    local handler = getCharacterHandler()
    local weaponHandler = getWeaponHandler(handler)
    if not weaponHandler then
        return false
    end

    local weaponType = handler.EquippedWeapon
    local skin = SelectedSkin[weaponType]
    if not skin then
        return false
    end

    local cosmetic = cosmeticId(skin, weaponType)
    if weaponHandler.CurrentCosmetic == cosmetic or AppliedCosmetics[weaponHandler] == cosmetic then
        return true
    end

    local finished, applied = false, false
    local thread = coroutine.create(function()
        local callOk, result = pcall(applyCosmetic, weaponHandler, cosmetic, skin)
        applied = callOk and result or false
        finished = true
    end)

    pcall(setthreadcontext, thread, 8)
    pcall(coroutine.resume, thread)

    local deadline = os.clock() + 2
    while not finished and os.clock() < deadline do
        task.wait()
        if not finished then
            pcall(coroutine.resume, thread)
        end
    end

    if applied then
        AppliedCosmetics[weaponHandler] = cosmetic
    end

    return applied
end

